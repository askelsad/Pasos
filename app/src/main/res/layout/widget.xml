    android:orientation="vertical" android:gravity="center" android:padding="12dp" android:background="#E61B5E20">
    <TextView android:id="@+id/w_steps" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="0 pasos" android:textSize="22sp" android:textStyle="bold" android:textColor="#FFFFFF" />
